# -----------------------------------------------------------------------------
# Pico Breadboard Kit .gitignore (KiCad 10)
# -----------------------------------------------------------------------------

# KiCad backups, autosave, lock files and local history
*-backups/
_autosave-*
*.lck
.history/
_pcbnew/

# KiCad per-user and cache files
fp-info-cache
*.kicad_prl
*.kicad_bak
*.kicad_sch-bak
*.sch-bak
sym-lib-table-bak
*.bak
*.bck
*.tmp

# Netlists, simulation and autorouter files
*.net
*.xml
*.dsn
*.ses
*.cir
*.raw
*.log
*.rpt

# Manufacturing outputs: ignored everywhere ...
*.gbr
*.gbrjob
*.drl
*.pos
*.csv
*.zip
GERBER/

# ... except the published copies in fabrication/ and docs/
!fabrication/**
!docs/**

# Local release staging (assets uploaded to GitHub Releases)
dist/

# OS / editor clutter
.DS_Store
Thumbs.db
*~
